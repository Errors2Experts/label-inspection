DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=lip
DB_USER=lip
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Set to 1 to use SQLite locally instead of PostgreSQL
USE_SQLITE=0
AI_API_KEY=
PRODUCT_API_BASE_URL=https://world.openfoodfacts.org/api/v2
# Email (password reset). Default prints emails to the console in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@lip.local
FRONTEND_RESET_URL=http://localhost:8000/reset-password
PRODUCT_API_TIMEOUT=5
THROTTLE_PRODUCT_LOOKUP=60/min
